# Notion API and Slack Integration Settings
# Copy this file to .env and fill in your actual values.

# Your Notion API integration token (from your Notion integration settings)
NOTION_API_TOKEN="YOUR_NOTION_API_TOKEN_HERE"

# The ID of the Notion database you want to connect to (for specs)
# This is no longer used by the script, but kept for reference.
# Project-specific DB IDs are now set in config.json.
NOTION_DATABASE_ID="YOUR_DATABASE_ID_HERE"

# The ID of the Notion database used for logging test run history
NOTION_HISTORY_DB_ID="YOUR_HISTORY_DATABASE_ID_HERE"

# Your Slack incoming webhook URL (from your Slack app settings)
# This is no longer used by the script, but kept for reference.
# Project-specific webhook URLs are now set in config.json.
SLACK_WEBHOOK_URL="YOUR_SLACK_WEBHOOK_URL_HERE"
