# Notion API and Slack Integration Settings
# Copy this file to .env and fill in your actual values.

# Your Notion API integration token (from your Notion integration settings)
NOTION_API_TOKEN="YOUR_NOTION_API_TOKEN_HERE"

# The ID of the Notion database you want to connect to
NOTION_DATABASE_ID="YOUR_NOTION_DATABASE_ID_HERE"

# Your Slack incoming webhook URL (from your Slack app settings)
SLACK_WEBHOOK_URL="YOUR_SLACK_WEBHOOK_URL_HERE"
